@page
@model KatMossPortfolio.Pages.IndexModel
@{
    ViewData["Title"] = "Home";
}

<section class="hero">
    <div class="hero-overlay">
        <h1>Hi, I'm Kat — an AI Gameplay Programmer & Games Developer</h1>
    </div>
</section>
<section class="popular-title">
    <h2>Most Popular</h2>
</section>

<div class="carousel-container">

    <button id="carouselPrev" class="carousel-arrow arrow-left">
        <span class="arrow-icon">&#10094;</span>
    </button>

    <div class="carousel-viewport">
        <div class="carousel-track-wrapper">
            <div class="carousel-track">
                @foreach (var project in Model.Projects)
                {
                    <div class="carousel-item">
                        <div class="carousel-image-wrapper">
                            <img src="@project.Image" alt="@project.Title" />
                            <a class="view-btn" asp-page="@project.Page">View Now</a>
                        </div>
                        <div class="project-title">@project.Title</div>
                    </div>
                }
            </div>
        </div>
    </div>

    <button id="carouselNext" class="carousel-arrow arrow-right">
        <span class="arrow-icon">&#10095;</span>
    </button>

</div>
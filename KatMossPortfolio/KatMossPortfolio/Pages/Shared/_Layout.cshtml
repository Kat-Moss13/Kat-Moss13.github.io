<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"] - Kat Moss</title>

    <link rel="stylesheet" href="~/css/theme.css" />
    <link rel="stylesheet" href="/css/site.css?v=@Guid.NewGuid()" />

    <script src="~/js/theme-toggle.js" defer></script>
    <script src="~/js/carousel.js" defer></script>
</head>

<body class="light">

    <header class="top-nav">
        <div class="brand">Kat Moss</div>

        <nav class="nav-right">
            <a asp-page="/Projects/Index">Projects</a>
            <a asp-page="/About">About</a>
            <a asp-page="/Resume">Resume</a>
            <a asp-page="/Contact">Contact</a>
        </nav>

        <button id="themeToggle" class="theme-switch">
            <div class="switch-track">
                <div class="switch-thumb">
                    <img src="~/images/sun.png" class="icon-sun" alt="Light mode" />
                    <img src="~/images/moon.png" class="icon-moon" alt="Dark mode" />
                </div>
            </div>
        </button>
    </header>

    <main>
        @RenderBody()
    </main>

</body>
</html>
